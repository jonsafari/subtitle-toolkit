# Include files
include README.md
include LICENSE
include pyproject.toml

# Include source files
recursive-include src *.py

# Include templates (moved to src/templates)
recursive-include src/templates *.html

# Include translations (moved to src/translations)
recursive-include src/translations *.json

# Include translation instruction prompts (moved to src/translation_instruction_prompts)
recursive-include src/translation_instruction_prompts *.txt

# Include static files (moved to src/static)
recursive-include src/static *

# Exclude test files
prune tests

# Exclude build artifacts
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.egg-info
global-exclude .pytest_cache
global-exclude .coverage
global-exclude .git
global-exclude .gitignore
global-exclude dist
global-exclude build

# Exclude media files
global-exclude *.mp3
global-exclude *.mp4
global-exclude *.mkv
global-exclude *.srt

# Exclude other non-essential files
global-exclude *.desktop
global-exclude *.sh
global-exclude Dockerfile
global-exclude requirements*.txt
global-exclude pytest.ini
